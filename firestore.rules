rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 🛡️ ZERO-TRUST MULTI-TENANCY MIDDLEWARE (Row-Level Security)
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(emailField) {
      return isAuthenticated() && (
        request.auth.token.email != null &&
        emailField != null &&
        request.auth.token.email.lower() == emailField.lower()
      );
    }

    function isUidOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email != null && request.auth.token.email.lower() in [
          'sayurujayani123@gmail.com',
          'admin@prrxhex.com',
          'sayuru@prrxhex.com'
        ]) ||
        (request.auth.token.admin == true) ||
        exists(/databases/$(database)/documents/system_admins/$(request.auth.token.email.lower())) ||
        exists(/databases/$(database)/documents/system_admins/$(request.auth.uid))
      );
    }

    // 🔒 RESTRICTED ADMIN & SYSTEM DATA
    match /system_admins/{adminId} {
      allow read, write: if isAdmin();
    }

    match /discord_webhooks/{configId} {
      allow read, write: if isAdmin();
    }

    match /transaction_ledger/{ledgerId} {
      allow read: if isAdmin();
      allow create: if true; // Sealed transaction append
      allow update, delete: if false; // Immutable hash ledger
    }

    // 🔑 LICENSE KEY BANK
    match /license_keys/{keyId} {
      // Admins have full access to manage Key Bank stock
      allow read, write: if isAdmin();
      // Allow atomic key dispensing during verified automated checkout
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'used_by', 'transaction_id', 'receipt_id', 'sold_date', 'verified_method', 'used_at']) &&
                      resource.data.status == 'available' &&
                      request.resource.data.status == 'used';
    }

    // 🛒 CUSTOMER RECEIPTS & SLIP UPLOADS
    match /receipts/{receiptId} {
      // Visitors and customers can create receipt submission
      allow create: if request.resource.data.expected_amount is number && request.resource.data.expected_amount >= 0;
      // Users can only read their own submitted receipts, admins can read all
      allow read: if isAdmin() || (isAuthenticated() && (
        resource.data.customer_email == request.auth.token.email ||
        (resource.data.customer_email != null && request.auth.token.email != null && resource.data.customer_email.lower() == request.auth.token.email.lower())
      ));
      // Only admins can update status or delete
      allow update, delete: if isAdmin();
    }

    // 🏢 RESELLER RECEIPTS & ACCOUNT REQUESTS
    match /reseller_receipts/{receiptId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin() || isOwner(resource.data.reseller_email) || (isAuthenticated() && resource.data.reseller_uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /reseller_account_requests/{reqId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // 👤 USER PROFILES & RESELLER TENANCY
    match /users/{userId} {
      allow read: if isAdmin() || isUidOwner(userId) || isOwner(resource.data.email);
      allow create: if isAuthenticated() && (isUidOwner(userId) || request.resource.data.email == request.auth.token.email);
      allow update: if isAdmin() || isUidOwner(userId) || isOwner(resource.data.email);
      allow delete: if isAdmin();
    }

    match /subscriptions/{subId} {
      allow read: if isAdmin() || isOwner(resource.data.resellerEmail);
      allow write: if isAdmin();
    }

    match /keys/{keyId} {
      allow read: if isAdmin() || isOwner(resource.data.resellerEmail);
      allow write: if isAdmin() || isOwner(resource.data.resellerEmail);
    }

    // 🌐 PUBLIC STOREFRONT DATA (Public Read-Only, Admin Write)
    match /price_plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /discounts/{discountId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /beneficiary_accounts/{accId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /download_links/{linkId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /v7a_apk_links/{linkId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /free_panels/{panelId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /service_status/{statusId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /announcements/{postId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /community_links/{linkId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /public_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 🛑 SYSTEM CONFIG & EMERGENCY MAINTENANCE KILL SWITCH
    match /system_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /panel_images/{imgId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /functions_screenshots/{screenshotId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 💬 CHAT & WORLD MESSAGES
    match /chat_conversations/{conversationId} {
      allow read, write: if isAuthenticated();
    }

    match /chat_messages/{messageId} {
      allow read, write: if isAuthenticated();
    }

    match /world_messages/{messageId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.user_id == request.auth.uid);
    }
  }
}
