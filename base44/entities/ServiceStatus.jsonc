{
  "name": "ServiceStatus",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Service name e.g. PRRX HEX WEB, INTERNAL PANEL"
    },
    "description": {
      "type": "string",
      "description": "Short description of the service"
    },
    "status": {
      "type": "string",
      "enum": [
        "online",
        "offline",
        "maintaining"
      ],
      "default": "online",
      "description": "Current status of the service"
    },
    "category": {
      "type": "string",
      "enum": [
        "website",
        "panel"
      ],
      "default": "panel",
      "description": "Which status section this belongs to"
    },
    "uptime_elapsed": {
      "type": "string",
      "description": "Elapsed time string e.g. 14d 2h or 0s"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "status",
    "category"
  ]
}