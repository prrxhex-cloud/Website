{
  "name": "PricePlan",
  "type": "object",
  "properties": {
    "panel_type": {
      "type": "string",
      "enum": [
        "external",
        "internal"
      ],
      "description": "Which panel this plan belongs to"
    },
    "label": {
      "type": "string",
      "description": "Duration label e.g. '1 Month'"
    },
    "lkr": {
      "type": "number",
      "description": "Price in LKR"
    },
    "days": {
      "type": "string",
      "description": "Days description e.g. '30+ Days'"
    },
    "popular": {
      "type": "boolean",
      "default": false
    },
    "crown": {
      "type": "boolean",
      "default": false,
      "description": "Lifetime/best value badge"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "panel_type",
    "label",
    "lkr"
  ]
}